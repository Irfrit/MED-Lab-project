fig, axes = plt.subplots(1, 2, figsize=(13, 5))
sns.heatmap(annual_corr, annot=True, fmt=".3f", cmap="vlag", center=0, vmin=-1, vmax=1, ax=axes[0])
axes[0].set_title("Dane roczne, 2007–2017")
user_corr = users_train[["time", "users_millions"]].corr()
sns.heatmap(user_corr, annot=True, fmt=".3f", cmap="vlag", center=0, vmin=-1, vmax=1, ax=axes[1])
axes[1].set_title("Dane kwartalne, do 2017 r.")
fig.suptitle("Macierze korelacji zmiennych ilościowych")
